{
  "version": "6.0",
  "extends": "config/video-quality-v5.json",
  "primary_visual_mode": "realistic_excel_demo_with_hidden_character_xray",
  "shorts": {
    "proof_failure_by_seconds": 1.2,
    "first_real_ui_action_by_seconds": 2.5,
    "target_duration_seconds": [
      29,
      31
    ],
    "caption_max_lines": 1,
    "real_ui_min_share": 0.7,
    "before_after_verification_required": true
  },
  "animation": {
    "allowed": [
      "cursor_action",
      "cell_selection",
      "formula_reveal",
      "diagnostic_number_reveal",
      "xray_character_reveal",
      "brief_camera_push",
      "before_after_split"
    ],
    "forbidden": [
      "fake_excel_menu",
      "random_particle_motion",
      "decorative_3d_without_explanatory_value",
      "large_centered_subtitle_cards",
      "continuous_scanner_effect"
    ],
    "xray_max_seconds": 2,
    "xray_label_required": true,
    "must_return_to_real_ui_immediately": true
  },
  "technical_guardrails": {
    "trim_claim": "TRIM removes ASCII space 32 but not non-breaking space 160 by itself.",
    "diagnostic": "Use LEN plus UNICODE(RIGHT(cell,1)) to make the mismatch visible.",
    "fix": "Replace UNICHAR(160) with a normal space, then TRIM.",
    "lookup": "XLOOKUP exact match is the default."
  }
}
